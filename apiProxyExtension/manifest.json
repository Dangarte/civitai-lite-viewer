{
    "manifest_version": 3,
    "name": "CivitAI API Bridge Extension",
    "description": "Enables the use of the direct Civitai API, instead of the public one, on the website \"dangarte.github.io/civitai-lite-viewer.\" It also marks images from civitai.com with a CORS header for requests from the website.",
    "version": "1.2",
    "permissions": [
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess",
        "cookies",
        "storage"
    ],
    "host_permissions": [
        "https://*.civitai.red/*",
        "https://*.civitai.com/*",
        "https://dangarte.github.io/civitai-lite-viewer/*"
    ],
    "background": {
        "service_worker": "service_worker.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://dangarte.github.io/civitai-lite-viewer/*"
            ],
            "world": "ISOLATED",
            "run_at": "document_start",
            "js": [
                "content_main_isolated.js"
            ],
            "all_frames": false
        },
        {
            "matches": [
                "https://dangarte.github.io/civitai-lite-viewer/*"
            ],
            "world": "MAIN",
            "run_at": "document_start",
            "js": [
                "content_main.js"
            ],
            "all_frames": false
        },
        {
            "matches": [
                "https://civitai.red/?bridge=true"
            ],
            "run_at": "document_start",
            "js": [
                "content_iframe.js"
            ],
            "all_frames": true
        }
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset_1",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    }
}